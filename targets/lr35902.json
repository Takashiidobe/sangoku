{
  "llvm-target": "x86_64-unknown-linux-gnu",
  "data-layout": "e-m:e-p:16:16-i8:8-i16:16-i32:16-n8:16-S16",
  "arch": "z80",
  "os": "none",
  "vendor": "unknown",
  "env": "",
  "target-pointer-width": 16,
