set enable_verifier=false
target z80

function %ld(i16) -> i32 system_v {
block0(v0: i16):
    v1 = load.i32 v0
    return v1
}

function %st(i16) system_v {
block0(v0: i16):
    v1 = iconst.i32 0x12345678
    store v1, v0
    return
}

; CHECK: SECTION "__rust_ld", ROM0
; CHECK-NEXT: EXPORT __rust_ld
; CHECK-NEXT: __rust_ld::
; CHECK-NEXT:   add sp, -4
; CHECK-NEXT: .block0:
; CHECK-NEXT:   ld d, b
; CHECK-NEXT:   ld b, c
; CHECK-NEXT:   ld c, d
; CHECK-NEXT:   ld h, b
; CHECK-NEXT:   ld l, c
; CHECK-NEXT:   ld a, [hl]
; CHECK-NEXT:   ld e, a
; CHECK-NEXT:   ld hl, sp + 0
; CHECK-NEXT:   ld [hl], e
; CHECK-NEXT:   ld h, b
; CHECK-NEXT:   ld l, c
; CHECK-NEXT:   inc hl
; CHECK-NEXT:   ld a, [hl]
; CHECK-NEXT:   ld e, a
; CHECK-NEXT:   ld hl, sp + 2
; CHECK-NEXT:   ld [hl], e
; CHECK-NEXT:   ld hl, $0002
; CHECK-NEXT:   add hl, bc
; CHECK-NEXT:   ld a, [hl]
; CHECK-NEXT:   ld e, a
; CHECK-NEXT:   ld hl, $0003
; CHECK-NEXT:   add hl, bc
; CHECK-NEXT:   ld a, [hl]
; CHECK-NEXT:   ld d, a
; CHECK-NEXT:   ld hl, sp + 2
; CHECK-NEXT:   ld b, [hl]
; CHECK-NEXT:   ld c, e
; CHECK-NEXT:   ld hl, sp + 0
; CHECK-NEXT:   ld a, [hl]
; CHECK-NEXT:   add sp, 4
; CHECK-NEXT:   ret
; CHECK-EMPTY:
