target z80

function %add16(i16, i16) -> i16 system_v {
block0(v0: i16, v1: i16):
    v2 = iadd v0, v1
    return v2
}

; CHECK: SECTION "__rust_add16", ROM0
; CHECK-NEXT: EXPORT __rust_add16
; CHECK-NEXT: __rust_add16::
; CHECK-NEXT: .block0:
; CHECK-NEXT:   ld e, a
; CHECK-NEXT:   push hl
; CHECK-NEXT: push af
; CHECK-NEXT: ld hl, sp + 6
; CHECK-NEXT: ld a, [hl]
; CHECK-NEXT: ld hl, sp + 3
; CHECK-NEXT: ld [hl], a
; CHECK-NEXT: pop af
; CHECK-NEXT: pop hl
; CHECK-NEXT:   ld a, b
; CHECK-NEXT: add a, e
; CHECK-NEXT: ld d, a
; CHECK-NEXT: ld a, c
; CHECK-NEXT: adc a, h
; CHECK-NEXT: ld b, a
; CHECK-NEXT:   ld a, d
; CHECK-NEXT:   ret
