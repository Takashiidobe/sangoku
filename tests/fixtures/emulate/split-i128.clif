function %sum128(i128, i128) -> i128 system_v {
block0(v0: i128, v1: i128):
    v2 = iadd v0, v1
    return v2
}

function %call_sum128(i16) system_v {
    sig0 = (i128, i128) -> i128 system_v
    fn0 = colocated %sum128 sig0
block0(v0: i16):
    v1 = load.i128 v0
    v2 = load.i128 v0+16
    v3 = call fn0(v1, v2)
    store v3, v0+32
    return
}

function %flow128(i16) system_v {
block0(v0: i16):
    v1 = load.i128 v0
    v2 = load.i128 v0+16
    brif v1, block1(v1), block1(v2)
block1(v3: i128):
    v4 = iconst.i64 -1
    v6 = iconcat v4, v4
    v5 = iadd v3, v6
    store v5, v0+32
    return
}

function %call_indirect_twice128(i16) system_v {
    sig0 = (i128, i128) -> i128 system_v
    fn0 = colocated %sum128 sig0
block0(v0: i16):
    v1 = load.i128 v0
    v2 = load.i128 v0+16
    v3 = func_addr.i16 fn0
    v4 = call_indirect sig0, v3(v1, v2)
    v5 = call_indirect sig0, v3(v4, v2)
    store v5, v0+32
    return
}

function %select128(i16) system_v {
block0(v0: i16):
    v1 = load.i128 v0
    v2 = load.i128 v0+16
    v3 = select v1, v1, v2
    store v3, v0+32
    return
}

function %loop128(i16) system_v {
block0(v0: i16):
    v1 = load.i128 v0
    v2 = load.i8 v0+16
    v3 = iconst.i8 3
    v4 = band v2, v3
    jump block1(v1, v4)
block1(v5: i128, v6: i8):
    brif v6, block2, block3(v5)
block2:
    v7 = iconst.i64 1
    v8 = uextend.i128 v7
    v9 = iadd v5, v8
    v10 = iconst.i8 1
    v11 = isub v6, v10
    jump block1(v9, v11)
block3(v12: i128):
    store v12, v0+32
    return
}

function %big_endian128(i16) system_v {
block0(v0: i16):
    v1 = load.i128 big v0
    store v1, v0+32
    v2 = load.i128 v0+16
    store big v2, v0+48
    return
}

function %conversions128(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = sextend.i128 v1
    store v2, v0+32
    v3 = uextend.i128 v1
    store v3, v0+48
    v4 = load.i128 v0+16
    v5, v6 = isplit v4
    v7 = iconcat v6, v5
    store v7, v0+64
    v8 = ireduce.i64 v4
    store v8, v0+80
    return
}
