set enable_multi_ret_implicit_sret=true
target z80

function %iadd128(i16) system_v {
block0(v0: i16):
    v1 = load.i128 v0
    v2 = load.i128 v0+16
    v3 = iadd v1, v2
    store v3, v0+32
    return
}

