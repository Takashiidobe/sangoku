function %uadd_overflow128(i16) system_v {
block0(v0: i16):
    v1 = load.i128 v0
    v2 = load.i128 v0+16
    v3, v4 = uadd_overflow v1, v2
    store v3, v0+32
    store v4, v0+48
    return
}

