set enable_multi_ret_implicit_sret=true
target z80

function %fadd64(i16) system_v {
block0(v0: i16):
    v1 = load.f64 v0
    v2 = load.f64 v0+8
    v4 = fadd v1, v2
    store v4, v0+24
    return
}

