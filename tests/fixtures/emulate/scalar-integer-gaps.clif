function %cls32(i16) system_v {
block0(v0: i16):
    v1 = load.i32 v0
    v2 = load.i32 v0+4
    v3 = cls v1
    store v3, v0+8
    return
}

function %istore8(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    istore8 v1, v0+16
    return
}

function %sload8(i16) system_v {
block0(v0: i16):
    v1 = sload8.i64 v0
    store v1, v0+16
    return
}

function %uload8(i16) system_v {
block0(v0: i16):
    v1 = uload8.i64 v0
