set enable_multi_ret_implicit_sret=true
target z80

function %uadd_overflow32(i16) system_v {
block0(v0: i16):
    v1 = load.i32 v0
    v2 = load.i32 v0+4
    v3, v4 = uadd_overflow v1, v2
    store v4, v0+12
    store v3, v0+8
    return
}

