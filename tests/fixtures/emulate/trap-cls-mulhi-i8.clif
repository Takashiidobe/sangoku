set enable_verifier=false
target z80

function %cls_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = cls v1
    return v2
}

function %umulhi_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+1
    v3 = umulhi v1, v2
    return v3
}

function %smulhi_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+1
    v3 = smulhi v1, v2
    return v3
}

function %trapnz_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    trapnz v1, user1
    return v1
}

function %trapz_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    trapz v1, user1
    return v1
}
