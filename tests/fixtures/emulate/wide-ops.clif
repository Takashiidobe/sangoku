set enable_verifier=false
target z80

function %imul_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+4
    v3 = imul v1, v2
    return v3
}

function %udiv_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+4
    v3 = udiv v1, v2
    return v3
}

function %urem_i8(i16) -> i8 system_v {
block0(v0: i16):
