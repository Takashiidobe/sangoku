set enable_verifier=false
target z80

function %smin_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+4
    v3 = smin v1, v2
    return v3
}

function %smax_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+4
    v3 = smax v1, v2
    return v3
}

function %umin_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+4
    v3 = umin v1, v2
    return v3
}

function %umax_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+4
    v3 = umax v1, v2
    return v3
}

function %iabs_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = iabs v1
    return v2
}

