    return v2
}

function %select_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+1
    v3 = load.i8 v0+2
    v6 = iconst.i8 0
    v4 = icmp ne v3, v6
    v5 = select v4, v1, v2
    return v5
}
