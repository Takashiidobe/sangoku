set enable_verifier=false
target z80

function %ushr0(i16) -> i32 system_v {
block0(v0: i16):
    v1 = load.i32 v0
    v2 = iconst.i32 0
    v3 = ushr v1, v2
    return v3
}

function %ushr0_live(i16) -> i32 system_v {
block0(v0: i16):
    v1 = load.i32 v0
    v2 = iconst.i32 0
    v3 = ushr v1, v2
    v4 = iadd v1, v3
    return v4
}

