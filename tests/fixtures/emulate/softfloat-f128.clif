set enable_multi_ret_implicit_sret=true
target z80

function %fadd128(i16) system_v {
block0(v0: i16):
    v1 = load.f128 v0
    v2 = load.f128 v0+16
    v4 = fadd v1, v2
    store v4, v0+48
    return
}

