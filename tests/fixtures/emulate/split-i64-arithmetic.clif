function %umul_overflow64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3, v4 = umul_overflow v1, v2
    store v4, v0+24
    store v3, v0+16
    return
}

function %smul_overflow64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3, v4 = smul_overflow v1, v2
    store v4, v0+24
    store v3, v0+16
    return
}

function %cls64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = cls v1
    store v3, v0+16
    return
}
