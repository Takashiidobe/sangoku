set enable_multi_ret_implicit_sret=true
target z80

function %udiv64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = udiv v1, v2
    store v3, v0+16
    return
}

function %urem64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = urem v1, v2
    store v3, v0+16
    return
}

function %sdiv64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = sdiv v1, v2
    store v3, v0+16
    return
}

function %srem64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = srem v1, v2
    store v3, v0+16
    return
}

function %umulhi64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = umulhi v1, v2
    store v3, v0+16
    return
}

function %smulhi64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = smulhi v1, v2
