set enable_verifier=false
target z80

function %from_sint_i8(i16) -> i32 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = fcvt_from_sint.f32 v1
    v9 = bitcast.i32 v2
    return v9
}

function %to_sint_i8(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.f32 v0
    v9 = fcvt_to_sint.i8 v1
    return v9
}

