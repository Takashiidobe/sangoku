function %uadd_overflow64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3, v4 = uadd_overflow v1, v2
    store v3, v0+16
    store v4, v0+24
    return
}

