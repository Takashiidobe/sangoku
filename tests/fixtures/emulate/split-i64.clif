function %sum64(i64, i64) -> i64 system_v {
block0(v0: i64, v1: i64):
    v2 = iadd v0, v1
    return v2
}

function %call_sum64(i16) system_v {
    sig0 = (i64, i64) -> i64 system_v
    fn0 = colocated %sum64 sig0
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = call fn0(v1, v2)
    store v3, v0+16
    return
}

function %flow64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    brif v1, block1(v1), block1(v2)
block1(v3: i64):
    v4 = iconst.i64 1
    v5 = iadd v3, v4
    v9 = iconst.i64 0
    v6 = icmp eq v5, v9
    brif v6, block2(v5), block3(v5)
block2(v7: i64):
    jump block3(v7)
block3(v8: i64):
    store v8, v0+16
    return
}

function %conversions64(i16) system_v {
block0(v0: i16):
    v1 = load.i16 v0
    v2 = sextend.i64 v1
    store v2, v0+16
    v3 = uextend.i64 v1
    store v3, v0+24
    v4 = load.i64 v0+8
    v5, v6 = isplit v4
    v7 = iconcat v6, v5
    store v7, v0+32
    v8 = ireduce.i16 v4
    store v8, v0+40
    return
}

function %loop64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i8 v0+8
    v3 = iconst.i8 3
    v4 = band v2, v3
    jump block1(v1, v4)
block1(v5: i64, v6: i8):
    brif v6, block2, block3(v5)
block2:
    v7 = iconst.i64 1
    v8 = iadd v5, v7
    v9 = iconst.i8 1
    v10 = isub v6, v9
    jump block1(v8, v10)
block3(v11: i64):
    store v11, v0+16
    return
}

function %select64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = select v1, v1, v2
    store v3, v0+16
    return
}

function %big_endian64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 big v0
    store v1, v0+16
    v2 = load.i64 v0+8
    store big v2, v0+24
    return
}

function %call_indirect_sum64(i16) system_v {
    sig0 = (i64, i64) -> i64 system_v
    fn0 = colocated %sum64 sig0
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = func_addr.i16 fn0
    v4 = call_indirect sig0, v3(v1, v2)
    store v4, v0+16
    return
}

function %call_indirect_twice64(i16) system_v {
    sig0 = (i64, i64) -> i64 system_v
    fn0 = colocated %sum64 sig0
block0(v0: i16):
    v1 = load.i64 v0
    v2 = load.i64 v0+8
    v3 = func_addr.i16 fn0
    v4 = call_indirect sig0, v3(v1, v2)
    v5 = call_indirect sig0, v3(v4, v2)
    store v5, v0+16
    return
}

function %constant_mul64(i16) system_v {
block0(v0: i16):
    v1 = load.i64 v0
    v2 = iconst.i64 65536
    v3 = imul v1, v2
    store v3, v0+16
    return
}

function %narrow_shift_wide_count64(i16) system_v {
block0(v0: i16):
    v1 = load.i32 v0
    v2 = load.i64 v0+8
    v3 = ishl v1, v2
    store v3, v0+16
    return
}
