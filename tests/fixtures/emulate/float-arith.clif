set enable_verifier=false
target z80

function %fadd(i16) -> i32 system_v {
block0(v0: i16):
    v1 = load.f32 v0
    v2 = load.f32 v0+4
    v3 = fadd v1, v2
    v4 = bitcast.i32 v3
    return v4
}

