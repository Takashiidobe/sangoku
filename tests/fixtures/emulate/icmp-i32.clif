set enable_verifier=false
target z80

function %cmp_eq(i16) -> i8 system_v {
block0(v0: i16):
    v1 = load.i32 v0
    v2 = load.i32 v0+4
    v3 = icmp eq v1, v2
    return v3
}

function %cmp_ne(i16) -> i8 system_v {
