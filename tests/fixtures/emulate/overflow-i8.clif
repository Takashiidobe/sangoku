set enable_verifier=false
target z80

function %uadd_overflow_i8(i16) -> i8, i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+1
    v3, v4 = uadd_overflow v1, v2
    return v3, v4
}

function %sadd_overflow_i8(i16) -> i8, i8 system_v {
block0(v0: i16):
    v1 = load.i8 v0
    v2 = load.i8 v0+1
    v3, v4 = sadd_overflow v1, v2
    return v3, v4
}

