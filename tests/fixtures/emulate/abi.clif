set enable_verifier=false
set enable_multi_ret_implicit_sret=true
target z80

function %sum5(i32, i32, i32, i32, i32) -> i32 system_v {
block0(v0: i32, v1: i32, v2: i32, v3: i32, v4: i32):
    v5 = iadd v0, v1
    v6 = iadd v5, v2
    v7 = iadd v6, v3
    v8 = iadd v7, v4
    return v8
}

function %quad(i32, i32, i32, i32, i32) -> i32, i32, i32, i32 system_v {
block0(v0: i32, v1: i32, v2: i32, v3: i32, v4: i32):
    v5 = iadd v0, v1
    v6 = iadd v2, v3
    v7 = bxor v4, v0
    v8 = isub v1, v4
    return v5, v6, v7, v8
}

function %call_sum5(i16) -> i32 system_v {
    sig0 = (i32, i32, i32, i32, i32) -> i32 system_v
    fn0 = colocated %sum5 sig0
block0(v0: i16):
    v1 = load.i32 v0
    v2 = load.i32 v0+4
    v3 = load.i32 v0+8
    v4 = load.i32 v0+12
    v5 = load.i32 v0+16
    v6 = call fn0(v1, v2, v3, v4, v5)
    return v6
}

function %call_quad(i16) system_v {
    sig0 = (i32, i32, i32, i32, i32) -> i32, i32, i32, i32 system_v
    fn0 = colocated %quad sig0
block0(v0: i16):
    v1 = load.i32 v0
    v2 = load.i32 v0+4
    v3 = load.i32 v0+8
    v4 = load.i32 v0+12
    v5 = load.i32 v0+16
    v6, v7, v8, v9 = call fn0(v1, v2, v3, v4, v5)
    store v6, v0+32
    store v7, v0+36
    store v8, v0+40
    store v9, v0+44
    return
}
